<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvExploreRank"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExploreName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sui Network"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExploreSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUI • Binance"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExplorePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$2.15"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExploreChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+12.85%"
                android:textColor="@color/surge_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indicator Match Badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBadgeIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_gain"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="✨ 5MA x 20MA Cross"
            android:textColor="@color/surge_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBadgeSurge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge_soar"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="🚀 89% Surge"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap for Chart ❯"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
