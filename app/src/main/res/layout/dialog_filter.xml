<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Filter &amp; Sort Settings"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Select exchange, market cap limits, and algorithmic sort dimensions."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Exchange Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="EXCHANGE"
            android:textColor="@color/qspi_violet"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterExBinance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_gain"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Binance"
                android:textColor="@color/surge_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterExCoinbase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Coinbase"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterExUpbit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Upbit"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterExBithumb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Bithumb"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Market Cap Filter -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MARKET CAP UNIVERSE"
            android:textColor="@color/qspi_violet"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterCap50"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_gain"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Top 50"
                android:textColor="@color/surge_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterCap100"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Top 100"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterCap200"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Top 200"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterCapAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="All"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Sorting Dimension (Real QSPI Sort Keys) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SORT DIMENSION"
            android:textColor="@color/qspi_violet"
            android:textSize="11sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSortDimensions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbSortSurgePotential"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingVertical="4dp"
                android:text="🚀 Surge Potential (%)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbSortUptrendPotential"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="📈 Uptrend Potential (%)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbSortGoldenCross"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="✨ 5d - 20d Golden Cross"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbSortContinuousRises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="🔥 Continuous Rises (Streaks)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbSortTradingSurge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="⚡ Highest Trading Surge Velocity"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbSortMarketCap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="🏆 Market Capitalization"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbSortCaution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="⚠️ Caution Designation Count"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- Apply Button -->
        <TextView
            android:id="@+id/btnApplyFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_badge_gain"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="Apply Screener Settings"
            android:textColor="@color/surge_green"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
